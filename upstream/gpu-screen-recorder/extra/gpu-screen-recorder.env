# Modified by Layer on 2026-11-10: use a generic example recording directory.
WINDOW=screen
CONTAINER=mp4
CODEC=h264
AUDIO_CODEC=opus
AUDIO_DEVICE=default_output
SECONDARY_AUDIO_DEVICE=default_input
FRAMERATE=60
REPLAYDURATION=60
OUTPUTDIR=./recordings
KEYINT=2
ENCODER=gpu
RESTORE_PORTAL_SESSION=yes