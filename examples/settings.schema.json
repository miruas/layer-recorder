{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layer recorder settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "library": {
      "type": "string",
      "default": "~/Videos/Layer"
    },
    "fps": {
      "type": "integer",
      "default": 60,
      "minimum": 1,
      "maximum": 240
    },
    "bitrate": {
      "type": "integer",
      "default": 18000,
      "minimum": 1000,
      "maximum": 200000
    },
    "buffer": {
      "type": "integer",
      "default": 300,
      "minimum": 300,
      "maximum": 300
    },
    "auto_replay": {
      "type": "boolean",
      "default": false
    },
    "gpu_vendor": {
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "nvidia",
        "amd",
        "intel"
      ]
    },
    "capture_backend": {
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "gsr",
        "wf-recorder"
      ]
    },
    "capture_codec": {
      "type": "string",
      "default": "h264",
      "enum": [
        "h264",
        "hevc",
        "av1"
      ]
    },
    "render_device": {
      "type": "string",
      "default": "auto",
      "pattern": "^(auto|/dev/dri/renderD[0-9]+)$"
    },
    "wf_no_dmabuf": {
      "type": "boolean",
      "default": false
    },
    "export_codec": {
      "type": "string",
      "default": "libx264",
      "enum": [
        "libx264",
        "libx265",
        "libaom-av1",
        "h264_nvenc",
        "hevc_nvenc",
        "av1_nvenc",
        "h264_vaapi",
        "hevc_vaapi",
        "av1_vaapi"
      ]
    },
    "export_quality": {
      "type": "integer",
      "default": 20,
      "minimum": 0,
      "maximum": 51
    },
    "gsr_binary": {
      "type": "string",
      "default": "auto"
    },
    "wf_recorder_binary": {
      "type": "string",
      "default": ""
    },
    "speech_binary": {
      "type": "string",
      "default": ""
    },
    "speech_model": {
      "type": "string",
      "default": ""
    }
  }
}
