{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layer recorder settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "library": {
      "type": "string",
      "default": "~/Videos/Layer"
    },
    "fps": {
      "type": "integer",
      "default": 60,
      "minimum": 1,
      "maximum": 240
    },
    "bitrate": {
      "type": "integer",
      "default": 18000,
      "minimum": 1000,
      "maximum": 200000
    },
    "buffer": {
      "type": "integer",
      "default": 300,
      "minimum": 2,
      "maximum": 86400
    },
    "auto_replay": {
      "type": "boolean",
      "default": false
    },
    "gpu_vendor": {
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "nvidia",
        "amd",
        "intel"
      ]
    },
    "capture_backend": {
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "gsr"
      ]
    },
    "capture_codec": {
      "type": "string",
      "default": "h264",
      "enum": [
        "auto",
        "h264",
        "hevc",
        "hevc_10bit",
        "hevc_hdr",
        "av1",
        "av1_10bit",
        "av1_hdr",
        "vp8",
        "vp9",
        "h264_vulkan",
        "hevc_vulkan",
        "hevc_hdr_vulkan",
        "hevc_10bit_vulkan",
        "av1_vulkan",
        "av1_hdr_vulkan",
        "av1_10bit_vulkan"
      ]
    },
    "render_device": {
      "type": "string",
      "default": "auto",
      "pattern": "^(auto|/dev/dri/renderD[0-9]+)$"
    },
    "wf_no_dmabuf": {
      "type": "boolean",
      "default": false
    },
    "export_codec": {
      "type": "string",
      "default": "libx264",
      "enum": [
        "libx264",
        "libx265",
        "libaom-av1",
        "h264_nvenc",
        "hevc_nvenc",
        "av1_nvenc",
        "h264_vaapi",
        "hevc_vaapi",
        "av1_vaapi"
      ]
    },
    "export_quality": {
      "type": "integer",
      "default": 20,
      "minimum": 0,
      "maximum": 51
    },
    "gsr_binary": {
      "type": "string",
      "default": "auto"
    },
    "wf_recorder_binary": {
      "type": "string",
      "default": ""
    },
    "speech_binary": {
      "type": "string",
      "default": ""
    },
    "speech_model": {
      "type": "string",
      "default": ""
    },
    "replay_short": {
      "type": "integer",
      "default": 60,
      "minimum": 1,
      "maximum": 86400
    },
    "replay_long": {
      "type": "integer",
      "default": 300,
      "minimum": 1,
      "maximum": 86400
    },
    "shortcuts_enabled": {
      "type": "boolean",
      "default": true
    },
    "shortcuts": {
      "type": "object",
      "default": {
        "ui": "Meta+Alt+Z",
        "save-1": "Meta+Alt+F7",
        "save-5": "Meta+Alt+F8",
        "record": "Meta+Alt+F9",
        "replay": "Meta+Alt+F10"
      },
      "additionalProperties": false,
      "properties": {
        "ui": {
          "type": "string"
        },
        "save-1": {
          "type": "string"
        },
        "save-5": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "replay": {
          "type": "string"
        }
      },
      "required": [
        "ui",
        "save-1",
        "save-5",
        "record",
        "replay"
      ]
    },
    "gsr_sync": {
      "type": "boolean",
      "default": false
    },
    "capture_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^;\\x00-\\x1f|{}]{1,63}(?:;(?:[xy]=[+-]?[0-9]{1,9}%?|(?:width|height)=\\+?[0-9]{1,9}%?|(?:halign|valign)=(?:start|center|end)|(?:hflip|vflip)=(?:true|false)|pixfmt=(?:auto|yuyv|mjpeg)|camera_(?:fps|width|height)=[0-9]{1,9}))*$",
        "description": "One independent GSR source with known semicolon modifiers. Modifier keys must be unique; Layer enforces this semantic constraint. Composite pipes and placeholders are excluded."
      },
      "maxItems": 16,
      "uniqueItems": true,
      "default": []
    },
    "gsr_preferences": {
      "type": "boolean",
      "default": true
    },
    "gsr_source": {
      "type": "string",
      "default": "gsr",
      "enum": [
        "gsr",
        "layer",
        "auto",
        "off"
      ]
    },
    "gsr_config": {
      "type": "string",
      "default": ""
    },
    "capture_quality": {
      "type": "string",
      "default": "custom",
      "enum": [
        "custom",
        "medium",
        "high",
        "very_high",
        "ultra"
      ]
    },
    "capture_resolution": {
      "default": "native",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "native",
            "720p",
            "1080p",
            "1440p",
            "4k"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 32,
              "maximum": 32768,
              "multipleOf": 2
            },
            "height": {
              "type": "integer",
              "minimum": 32,
              "maximum": 32768,
              "multipleOf": 2
            }
          }
        }
      ]
    },
    "preview_resolution": {
      "default": "native",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "native",
            "1080p",
            "1440p",
            "4k"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 32,
              "maximum": 32768,
              "multipleOf": 2
            },
            "height": {
              "type": "integer",
              "minimum": 32,
              "maximum": 32768,
              "multipleOf": 2
            }
          }
        }
      ]
    },
    "preview_fps": {
      "default": "source",
      "oneOf": [
        {
          "const": "source"
        },
        {
          "type": "integer",
          "enum": [
            60,
            120
          ]
        }
      ]
    },
    "capture_advanced": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "Advanced GSR producer settings. Layer manages output, segments, replay storage and timestamps. See docs/GSR_CLI.md.",
      "properties": {
        "bitrate_mode": {
          "type": "string",
          "enum": [
            "auto",
            "qp",
            "vbr",
            "cbr"
          ]
        },
        "framerate_mode": {
          "type": "string",
          "enum": [
            "cfr",
            "vfr",
            "content"
          ]
        },
        "pixel_format": {
          "type": "string",
          "enum": [
            "yuv420",
            "yuv444"
          ]
        },
        "color_range": {
          "type": "string",
          "enum": [
            "limited",
            "full"
          ]
        },
        "tune": {
          "type": "string",
          "enum": [
            "performance",
            "quality"
          ]
        },
        "encoder": {
          "type": "string",
          "enum": [
            "gpu",
            "cpu"
          ]
        },
        "audio_codec": {
          "type": "string",
          "enum": [
            "opus",
            "aac",
            "mp3"
          ]
        },
        "cursor": {
          "type": "boolean"
        },
        "fallback_cpu_encoding": {
          "type": "boolean"
        },
        "low_power": {
          "type": "boolean"
        },
        "restore_portal_session": {
          "type": "boolean"
        },
        "overclock": {
          "type": "boolean"
        },
        "verbose": {
          "type": "boolean"
        },
        "gl_debug": {
          "type": "boolean"
        },
        "exclude_metadata": {
          "type": "boolean"
        },
        "keyint": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Seconds; bounded by Layer segment and snapshot timing."
        },
        "audio_bitrate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000,
          "description": "kbps; zero lets GSR choose."
        },
        "portal_session_token_filepath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f{};]+$"
        },
        "plugins": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "allOf": [
              {
                "pattern": "^[^\\x00-\\x1f{};]+$"
              },
              {
                "pattern": "^/.*\\.so$"
              }
            ]
          },
          "description": "Absolute paths to native plugins that GSR executes in each video producer."
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "x",
            "y"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "height": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "x": {
              "type": "integer",
              "minimum": -131072,
              "maximum": 131072
            },
            "y": {
              "type": "integer",
              "minimum": -131072,
              "maximum": 131072
            }
          }
        },
        "video_options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aq-strength": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "b_ref_mode": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "coder": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "cq": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "level": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "look_ahead": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "preset": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "profile": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "qp": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "rc_mode": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "spatial_aq": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "temporal_aq": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "description": "Restricted codec-private option map. Encoder support varies; muxer/timeline options are excluded."
        },
        "audio_options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "aac_coder": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "aac_pce": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "application": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "compression_level": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "cutoff": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "frame_duration": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "vbr": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.+:/-]{1,128}$"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "description": "Restricted codec-private option map. Encoder support varies; muxer/timeline options are excluded."
        }
      }
    }
  },
  "description": "Layer settings. Python validate_config is authoritative for replay_short <= replay_long <= buffer, unique shortcut/modifier keys, and strict integer types. JSON Schema integer semantics also admit integral JSON numbers such as 1.0.",
  "allOf": [
    {
      "if": {
        "required": [
          "capture_advanced"
        ],
        "properties": {
          "capture_advanced": {
            "required": [
              "encoder"
            ],
            "properties": {
              "encoder": {
                "const": "cpu"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "capture_codec": {
            "enum": [
              "auto",
              "h264"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "capture_advanced"
        ],
        "properties": {
          "capture_advanced": {
            "required": [
              "bitrate_mode"
            ],
            "properties": {
              "bitrate_mode": {
                "const": "cbr"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "capture_quality": {
            "const": "custom"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "capture_advanced"
        ],
        "properties": {
          "capture_advanced": {
            "required": [
              "bitrate_mode"
            ],
            "properties": {
              "bitrate_mode": {
                "enum": [
                  "auto",
                  "qp",
                  "vbr"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "capture_quality"
        ],
        "properties": {
          "capture_quality": {
            "enum": [
              "medium",
              "high",
              "very_high",
              "ultra"
            ]
          }
        }
      }
    }
  ]
}
