{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layer recorder settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "library": {
      "type": "string",
      "default": "~/Videos/Layer"
    },
    "fps": {
      "type": "integer",
      "default": 60,
      "minimum": 1,
      "maximum": 240
    },
    "bitrate": {
      "type": "integer",
      "default": 18000,
      "minimum": 1000,
      "maximum": 200000
    },
    "buffer": {
      "type": "integer",
      "default": 300,
      "minimum": 2,
      "maximum": 86400
    },
    "auto_replay": {
      "type": "boolean",
      "default": false
    },
    "gpu_vendor": {
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "nvidia",
        "amd",
        "intel"
      ]
    },
    "capture_backend": {
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "gsr"
      ]
    },
    "capture_codec": {
      "type": "string",
      "default": "h264",
      "enum": [
        "auto",
        "h264",
        "hevc",
        "hevc_10bit",
        "hevc_hdr",
        "av1",
        "av1_10bit",
        "av1_hdr"
      ]
    },
    "render_device": {
      "type": "string",
      "default": "auto",
      "pattern": "^(auto|/dev/dri/renderD[0-9]+)$"
    },
    "wf_no_dmabuf": {
      "type": "boolean",
      "default": false
    },
    "export_codec": {
      "type": "string",
      "default": "libx264",
      "enum": [
        "libx264",
        "libx265",
        "libaom-av1",
        "h264_nvenc",
        "hevc_nvenc",
        "av1_nvenc",
        "h264_vaapi",
        "hevc_vaapi",
        "av1_vaapi"
      ]
    },
    "export_quality": {
      "type": "integer",
      "default": 20,
      "minimum": 0,
      "maximum": 51
    },
    "gsr_binary": {
      "type": "string",
      "default": "auto"
    },
    "wf_recorder_binary": {
      "type": "string",
      "default": ""
    },
    "speech_binary": {
      "type": "string",
      "default": ""
    },
    "speech_model": {
      "type": "string",
      "default": ""
    },
    "replay_short": {
      "type": "integer",
      "default": 60,
      "minimum": 1,
      "maximum": 86400
    },
    "replay_long": {
      "type": "integer",
      "default": 300,
      "minimum": 1,
      "maximum": 86400
    },
    "shortcuts_enabled": {
      "type": "boolean",
      "default": true
    },
    "shortcuts": {
      "type": "object",
      "default": {
        "ui": "Meta+Alt+Z",
        "save-1": "Meta+Alt+F7",
        "save-5": "Meta+Alt+F8",
        "record": "Meta+Alt+F9",
        "replay": "Meta+Alt+F10"
      },
      "additionalProperties": false,
      "properties": {
        "ui": {
          "type": "string"
        },
        "save-1": {
          "type": "string"
        },
        "save-5": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "replay": {
          "type": "string"
        }
      },
      "required": [
        "ui",
        "save-1",
        "save-5",
        "record",
        "replay"
      ]
    },
    "gsr_sync": {
      "type": "boolean",
      "default": false
    },
    "capture_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 16,
      "uniqueItems": true,
      "default": []
    },
    "gsr_preferences": {
      "type": "boolean",
      "default": true
    },
    "gsr_source": {
      "type": "string",
      "default": "gsr",
      "enum": [
        "gsr",
        "layer",
        "auto",
        "off"
      ]
    },
    "gsr_config": {
      "type": "string",
      "default": ""
    },
    "capture_quality": {
      "type": "string",
      "default": "custom",
      "enum": [
        "custom",
        "medium",
        "high",
        "very_high",
        "ultra"
      ]
    },
    "capture_resolution": {
      "default": "native",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "native",
            "720p",
            "1080p",
            "1440p",
            "4k"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 32,
              "maximum": 32768,
              "multipleOf": 2
            },
            "height": {
              "type": "integer",
              "minimum": 32,
              "maximum": 32768,
              "multipleOf": 2
            }
          }
        }
      ]
    },
    "preview_resolution": {
      "default": "native",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "native",
            "1080p",
            "1440p",
            "4k"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 32,
              "maximum": 32768,
              "multipleOf": 2
            },
            "height": {
              "type": "integer",
              "minimum": 32,
              "maximum": 32768,
              "multipleOf": 2
            }
          }
        }
      ]
    },
    "preview_fps": {
      "default": "source",
      "oneOf": [
        {
          "const": "source"
        },
        {
          "type": "integer",
          "enum": [
            60,
            120
          ]
        }
      ]
    }
  }
}
