+
+    // Modified by Layer on 2026-11-10: add workspace actions, state mirroring and bounded private-title-free naming.
+    // Share GSR's configured hotkeys and menu actions with Layer. The controller
+    // receives explicit states, so opening the overlay cannot toggle capture.
+    static void mirror_layer_action(const char *action) {
+        const char *args[] = { "layer", "bridge", action, nullptr };
+        exec_program_daemonized(args, false);
+    }
+
+    // GSR's signal-based save actions have fixed durations.  Use its IPC
+    // interface for the configured short/long durations, with an exact-signal
+    // fallback for older recorders that predate the IPC save request.
+    static std::string get_replay_ipc_socket_path() {
+        const char *runtime_dir = getenv("XDG_RUNTIME_DIR");
+        const std::string directory = runtime_dir ? runtime_dir : "/tmp";
+        char filename[64];
+        snprintf(filename, sizeof(filename), "gsr-ui-replay-%d.sock", (int)getpid());
+        std::string path = directory + "/" + filename;
+        if(path.size() >= sizeof(((struct sockaddr_un*)nullptr)->sun_path)) {
+            path = std::string("/tmp/") + filename;
+        }
+        return path;
+    }
+
+    static bool save_replay_via_ipc(const std::string &socket_path, int seconds) {
+        if(socket_path.empty() || socket_path.size() >= sizeof(((struct sockaddr_un*)nullptr)->sun_path))
+            return false;
+
+        struct sockaddr_un address;
+        memset(&address, 0, sizeof(address));
+        address.sun_family = AF_UNIX;
+        memcpy(address.sun_path, socket_path.c_str(), socket_path.size());
+
+        const int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+        if(fd < 0)
+            return false;
+
+        struct timeval timeout;
+        timeout.tv_sec = 2;
+        timeout.tv_usec = 0;
+        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+
+        if(connect(fd, (const struct sockaddr*)&address, sizeof(address)) == -1) {
+            close(fd);
+            return false;
+        }
+
+        char request[128];
+        const int request_size = snprintf(request, sizeof(request), "{\"id\":1,\"name\":\"save-replay\",\"data\":{\"seconds\":%d}}\n", seconds);
+        bool success = false;
+        if(request_size > 0 && request_size < (int)sizeof(request)) {
+            success = true;
+            int offset = 0;
+            while(offset < request_size) {
+                const ssize_t bytes_sent = send(fd, request + offset, request_size - offset, MSG_NOSIGNAL);
+                if(bytes_sent > 0) {
+                    offset += (int)bytes_sent;
+                    continue;
+                }
+                if(bytes_sent == -1 && errno == EINTR)
+                    continue;
+                success = false;
+                break;
+            }
+        }
+
+        close(fd);
+        return success;
+    }
+
+    static int replay_signal_for_exact_seconds(int seconds) {
+        switch(seconds) {
+            case 10:   return SIGRTMIN + 1;
+            case 30:   return SIGRTMIN + 2;
+            case 60:   return SIGRTMIN + 3;
+            case 300:  return SIGRTMIN + 4;
+            case 600:  return SIGRTMIN + 5;
+            case 1800: return SIGRTMIN + 6;
+            default:   return 0;
+        }
+    }
+
+    static bool request_save_replay(pid_t recorder_process, const std::string &ipc_socket_path, int seconds) {
+        if(save_replay_via_ipc(ipc_socket_path, seconds))
+            return true;
+
+        const int signal_value = replay_signal_for_exact_seconds(seconds);
+        if(signal_value == 0)
+            return false;
+
+        return kill(recorder_process, signal_value) == 0;
+    }
